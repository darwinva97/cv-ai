# ===========================================
# Base de datos
# ===========================================
DATABASE_URL=postgresql://user:password@localhost:5432/cv_ai

# ===========================================
# Autenticación (better-auth)
# ===========================================
# Secreto para firmar tokens (genera uno con: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-secret-key-here

# URL base de la aplicación
BETTER_AUTH_URL=http://localhost:3000

# OAuth - GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===========================================
# AI Providers (opcional - los usuarios configuran los suyos)
# ===========================================
# OpenAI (para funcionalidades del sistema si aplica)
# OPENAI_API_KEY=sk-...

# Anthropic (para funcionalidades del sistema si aplica)
# ANTHROPIC_API_KEY=sk-ant-...

# ===========================================
# Aplicación
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
